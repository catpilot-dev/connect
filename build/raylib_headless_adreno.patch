diff --git a/src/external/glfw/src/egl_context.c b/src/external/glfw/src/egl_context.c
index ef65dd3..ba127ce 100644
--- a/src/external/glfw/src/egl_context.c
+++ b/src/external/glfw/src/egl_context.c
@@ -32,6 +32,12 @@
 #include <stdlib.h>
 #include <assert.h>
 
+// COD: GBM support for headless EGL on Adreno (null platform)
+#if defined(__linux__)
+#include <fcntl.h>
+#include <gbm.h>
+#endif
+
 
 // Return a description of the specified EGL error
 //
@@ -133,8 +139,14 @@ static GLFWbool chooseEGLConfig(const _GLFWctxconfig* ctxconfig,
         if (getEGLConfigAttrib(n, EGL_COLOR_BUFFER_TYPE) != EGL_RGB_BUFFER)
             continue;
 
-        // Only consider window EGLConfigs
-        if (!(getEGLConfigAttrib(n, EGL_SURFACE_TYPE) & EGL_WINDOW_BIT))
+        // Only consider compatible EGLConfigs
+        // COD: Accept pbuffer configs for null platform (headless)
+        if (_glfw.platform.platformID == GLFW_PLATFORM_NULL)
+        {
+            if (!(getEGLConfigAttrib(n, EGL_SURFACE_TYPE) & 0x0001 /*EGL_PBUFFER_BIT*/))
+                continue;
+        }
+        else if (!(getEGLConfigAttrib(n, EGL_SURFACE_TYPE) & EGL_WINDOW_BIT))
             continue;
 
 #if defined(_GLFW_X11)
@@ -375,6 +387,8 @@ GLFWbool _glfwInitEGL(void)
 #elif defined(__OpenBSD__) || defined(__NetBSD__)
         "libEGL.so",
 #else
+        // COD: Try Adreno EGL first (supports GBM display), then GLVND
+        "libEGL_adreno.so",
         "libEGL.so.1",
 #endif
         NULL
@@ -420,6 +434,8 @@ GLFWbool _glfwInitEGL(void)
         _glfwPlatformGetModuleSymbol(_glfw.egl.handle, "eglDestroyContext");
     _glfw.egl.CreateWindowSurface = (PFN_eglCreateWindowSurface)
         _glfwPlatformGetModuleSymbol(_glfw.egl.handle, "eglCreateWindowSurface");
+    _glfw.egl.CreatePbufferSurface = (PFN_eglCreatePbufferSurface)
+        _glfwPlatformGetModuleSymbol(_glfw.egl.handle, "eglCreatePbufferSurface");
     _glfw.egl.MakeCurrent = (PFN_eglMakeCurrent)
         _glfwPlatformGetModuleSymbol(_glfw.egl.handle, "eglMakeCurrent");
     _glfw.egl.SwapBuffers = (PFN_eglSwapBuffers)
@@ -487,16 +503,41 @@ GLFWbool _glfwInitEGL(void)
             eglGetProcAddress("eglCreatePlatformWindowSurfaceEXT");
     }
 
-    _glfw.egl.platform = _glfw.platform.getEGLPlatform(&attribs);
-    if (_glfw.egl.platform)
+    // COD: For null platform on Adreno, use GBM-backed EGL display
+    //      (EGL_DEFAULT_DISPLAY segfaults on Qualcomm drivers)
+    if (_glfw.platform.platformID == GLFW_PLATFORM_NULL)
     {
-        _glfw.egl.display =
-            eglGetPlatformDisplayEXT(_glfw.egl.platform,
-                                     _glfw.platform.getEGLNativeDisplay(),
-                                     attribs);
+        // COD: Use render node (no DRM master needed) for headless GPU access
+        int drm_fd = open("/dev/dri/renderD128", O_RDWR);
+        if (drm_fd < 0) drm_fd = open("/dev/dri/card0", O_RDWR);
+        if (drm_fd >= 0)
+        {
+            struct gbm_device* gbm = gbm_create_device(drm_fd);
+            if (gbm)
+            {
+                // Call the real eglGetDisplay, not the macro
+                // (macro routes through _glfw.egl which may have issues)
+                typedef EGLDisplay (*PFN_real_eglGetDisplay)(EGLNativeDisplayType);
+                PFN_real_eglGetDisplay realGetDisplay = (PFN_real_eglGetDisplay)
+                    _glfwPlatformGetModuleSymbol(_glfw.egl.handle, "eglGetDisplay");
+                if (realGetDisplay)
+                    _glfw.egl.display = realGetDisplay((EGLNativeDisplayType)gbm);
+            }
+        }
     }
     else
-        _glfw.egl.display = eglGetDisplay(_glfw.platform.getEGLNativeDisplay());
+    {
+        _glfw.egl.platform = _glfw.platform.getEGLPlatform(&attribs);
+        if (_glfw.egl.platform)
+        {
+            _glfw.egl.display =
+                eglGetPlatformDisplayEXT(_glfw.egl.platform,
+                                         _glfw.platform.getEGLNativeDisplay(),
+                                         attribs);
+        }
+        else
+            _glfw.egl.display = eglGetDisplay(_glfw.platform.getEGLNativeDisplay());
+    }
 
     _glfw_free(attribs);
 
@@ -710,24 +751,44 @@ GLFWbool _glfwCreateContextEGL(_GLFWwindow* window,
 
     SET_ATTRIB(EGL_NONE, EGL_NONE);
 
-    native = _glfw.platform.getEGLNativeWindow(window);
-    // HACK: ANGLE does not implement eglCreatePlatformWindowSurfaceEXT
-    //       despite reporting EGL_EXT_platform_base
-    if (_glfw.egl.platform && _glfw.egl.platform != EGL_PLATFORM_ANGLE_ANGLE)
+    // COD: Use pbuffer surface for null platform (headless rendering)
+#ifndef EGL_WIDTH
+#define EGL_WIDTH  0x3057
+#endif
+#ifndef EGL_HEIGHT
+#define EGL_HEIGHT 0x3056
+#endif
+    if (_glfw.platform.platformID == GLFW_PLATFORM_NULL)
     {
+        const EGLint pbufferAttribs[] = {
+            EGL_WIDTH, window->videoMode.width ? window->videoMode.width : 1928,
+            EGL_HEIGHT, window->videoMode.height ? window->videoMode.height : 1208,
+            EGL_NONE,
+        };
         window->context.egl.surface =
-            eglCreatePlatformWindowSurfaceEXT(_glfw.egl.display, config, native, attribs);
+            eglCreatePbufferSurface(_glfw.egl.display, config, pbufferAttribs);
     }
     else
     {
-        window->context.egl.surface =
-            eglCreateWindowSurface(_glfw.egl.display, config, native, attribs);
+        native = _glfw.platform.getEGLNativeWindow(window);
+        // HACK: ANGLE does not implement eglCreatePlatformWindowSurfaceEXT
+        //       despite reporting EGL_EXT_platform_base
+        if (_glfw.egl.platform && _glfw.egl.platform != EGL_PLATFORM_ANGLE_ANGLE)
+        {
+            window->context.egl.surface =
+                eglCreatePlatformWindowSurfaceEXT(_glfw.egl.display, config, native, attribs);
+        }
+        else
+        {
+            window->context.egl.surface =
+                eglCreateWindowSurface(_glfw.egl.display, config, native, attribs);
+        }
     }
 
     if (window->context.egl.surface == EGL_NO_SURFACE)
     {
         _glfwInputError(GLFW_PLATFORM_ERROR,
-                        "EGL: Failed to create window surface: %s",
+                        "EGL: Failed to create surface: %s",
                         getEGLErrorString(eglGetError()));
         return GLFW_FALSE;
     }
diff --git a/src/external/glfw/src/internal.h b/src/external/glfw/src/internal.h
